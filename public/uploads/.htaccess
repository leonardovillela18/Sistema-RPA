Options -Indexes -ExecCGI
SetHandler none
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh .shtml
<FilesMatch "(?i)^(?![a-f0-9]{40}\.(jpg|png|webp)$).*$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^[a-f0-9]{40}\.(jpg|png|webp)$">
    SetHandler default-handler
</FilesMatch>
